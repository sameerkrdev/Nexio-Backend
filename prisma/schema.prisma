// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  pending
  completed
  failed
  expired
  cancelled
}

enum WalletStatus {
  active
  frozen
  closed
}

enum WalletTransactionType {
  credit
  debit
}

enum WalletTransactionStatus {
  pending
  completed
  failed
  reversed
}

enum WalletEntryReason {
  payment_received
  withdrawal_initiated
  withdrawal_refunded
  fee_charged
  admin_credit
  admin_debit
  reversal
}

model User {
  id              String         @id @default(uuid()) @map("id")
  username        String         @unique @map("username")
  phoneNumber     String         @unique @map("phone_number")
  name            String         @map("name")
  password        String?        @map("password") // Optional: bcrypt hashed password
  email           String?        @map("email")
  solanaPublicKey String?        @map("solana_public_key")
  createdAt       DateTime       @default(now()) @map("created_at")
  refreshTokens   RefreshToken[]
  payments        Payment[]      @relation("SenderPayments")
  wallet          Wallet?

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash") // bcrypt(12) hash — for rotation verification
  lookupHash String   @unique @map("lookup_hash") // sha256 — fast deterministic lookup for logout
  deviceId   String   @map("device_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model Payment {
  id                String        @id @default(cuid()) @map("id")
  senderId          String        @map("sender_id")
  sender            User          @relation("SenderPayments", fields: [senderId], references: [id])
  recipientUsername String        @map("recipient_username")
  recipientUserId   String        @map("recipient_user_id")
  senderPublicKey   String        @map("sender_public_key")
  status            PaymentStatus @default(pending) @map("status")
  txHash            String?       @unique @map("tx_hash")
  cryptoType             String   @map("crypto_type")
  cryptoAmount           Decimal  @map("crypto_amount")
  platformFeeAmount      Decimal  @map("platform_fee_amount")
  platformFeeCrypto      Decimal  @map("platform_fee_crypto")
  totalCryptoAmount      Decimal  @map("total_crypto_amount")
  senderCurrency         String   @map("sender_currency")
  senderCurrencyAmount   Decimal  @map("sender_currency_amount")
  receiverCurrency       String   @map("receiver_currency")
  receiverCurrencyAmount Decimal  @map("receiver_currency_amount")
  cryptoToSenderRate     Decimal  @map("crypto_to_sender_rate")
  senderToReceiverRate   Decimal  @map("sender_to_receiver_rate")
  platformFeePercent     Decimal  @map("platform_fee_percent")
  rateSource             String   @map("rate_source")
  rateSnapshotAt         DateTime @map("rate_snapshot_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  expiresAt         DateTime      @map("expires_at")
  completedAt       DateTime?     @map("completed_at")
  failureReason     String?       @map("failure_reason")

  @@index([status, expiresAt])
  @@index([senderId])
  @@index([recipientUserId])
  @@map("payments")
}

model WebhookCursor {
  id            String   @id @default("singleton") @map("id")
  lastSignature String?  @map("last_signature")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("webhook_cursor")
}

model Wallet {
  id              String       @id @default(cuid()) @map("id")
  userId          String       @unique @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  currency        String       @default("INR") @map("currency")
  balance         Decimal      @default(0) @map("balance")
  reservedBalance Decimal      @default(0) @map("reserved_balance")
  status          WalletStatus @default(active) @map("status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  transactions  WalletTransaction[]
  debitEntries  LedgerEntry[]       @relation("DebitWallet")
  creditEntries LedgerEntry[]       @relation("CreditWallet")

  @@map("wallets")
}

model WalletTransaction {
  id                   String                  @id @default(cuid()) @map("id")
  walletId             String                  @map("wallet_id")
  wallet               Wallet                  @relation(fields: [walletId], references: [id])
  type                 WalletTransactionType   @map("type")
  amount               Decimal                 @map("amount")
  balanceBefore        Decimal                 @map("balance_before")
  balanceAfter         Decimal                 @map("balance_after")
  status               WalletTransactionStatus @default(completed) @map("status")
  reason               WalletEntryReason       @map("reason")
  title                String                  @map("title")
  description          String?                 @map("description")
  referenceType        String?                 @map("reference_type")
  referenceId          String?                 @map("reference_id")
  counterpartyId       String?                 @map("counterparty_id")
  counterpartyUsername String?                 @map("counterparty_username")
  counterpartyName     String?                 @map("counterparty_name")
  metadata             Json?                   @map("metadata")
  createdAt            DateTime                @default(now()) @map("created_at")
  ledgerEntry          LedgerEntry?

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model LedgerEntry {
  id                  String             @id @default(cuid()) @map("id")
  debitWalletId       String             @map("debit_wallet_id")
  creditWalletId      String             @map("credit_wallet_id")
  debitWallet         Wallet             @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet        Wallet             @relation("CreditWallet", fields: [creditWalletId], references: [id])
  amount              Decimal            @map("amount")
  currency            String             @default("INR") @map("currency")
  reason              WalletEntryReason  @map("reason")
  walletTransactionId String?            @unique @map("wallet_transaction_id")
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  referenceType       String?            @map("reference_type")
  referenceId         String?            @map("reference_id")
  note                String?            @map("note")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([debitWalletId])
  @@index([creditWalletId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}
