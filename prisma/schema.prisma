// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  pending
  completed
  failed
  expired
  cancelled
}

enum WalletStatus {
  active
  frozen
  closed
}

enum WalletTransactionType {
  credit
  debit
}

enum WalletTransactionStatus {
  pending
  completed
  failed
  reversed
}

enum WalletEntryReason {
  payment_received
  withdrawal_initiated
  withdrawal_refunded
  fee_charged
  admin_credit
  admin_debit
  reversal
}

enum Currency {
  SOL
  USDT
  LINK
}

enum SwapStatus {
  pending
  in_progress
  completed
  failed
  skipped
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
  cancelled
  refunded
}

enum WithdrawalMethod {
  UPI
  BANK_TRANSFER
  IMPS
  NEFT
  ZELLE
  ACH
  WIRE
  FASTER_PAYMENTS
  SEPA
  SEPA_INSTANT
  PAYNOW
  FAST
  ZENGIN
  OSKO
  NPP
  INTERAC
  EFT
}

enum CountryCode {
  IN
  US
  GB
  EU
  JP
  SG
  AU
  CA
}

model User {
  id                 String              @id @default(uuid()) @map("id")
  username           String              @unique @map("username")
  phoneNumber        String              @unique @map("phone_number")
  name               String              @map("name")
  password           String?             @map("password") // Optional: bcrypt hashed password
  email              String?             @map("email")
  solanaPublicKey    String?             @map("solana_public_key")
  // Premium subscription: when set in the future, user is on the premium plan.
  // Activated by a Dodo payment with metadata.purpose = 'subscription'.
  subscriptionExpiresAt DateTime?         @map("subscription_expires_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  refreshTokens      RefreshToken[]
  payments           Payment[]           @relation("SenderPayments")
  receivedPayments   Payment[]           @relation("ReceiverPayments")
  wallet             Wallet?
  profile            UserProfile?
  withdrawalAccounts WithdrawalAccount[]
  withdrawals        Withdrawal[]
  pushTokens         PushToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash") // bcrypt(12) hash — for rotation verification
  lookupHash String   @unique @map("lookup_hash") // sha256 — fast deterministic lookup for logout
  deviceId   String   @map("device_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model Payment {
  id                     String        @id @default(cuid()) @map("id")
  senderId               String        @map("sender_id")
  sender                 User          @relation("SenderPayments", fields: [senderId], references: [id])
  receiver               User?         @relation("ReceiverPayments", fields: [recipientUserId], references: [id])
  recipientUsername      String        @map("recipient_username")
  recipientType          String        @default("platform") @map("recipient_type")
  recipientUserId        String?       @map("recipient_user_id")
  externalRecipientId    String?       @map("external_recipient_id")
  externalRecipient      ExternalRecipient? @relation(fields: [externalRecipientId], references: [id])
  senderPublicKey        String        @map("sender_public_key")
  status                 PaymentStatus @default(pending) @map("status")
  txHash                 String?       @unique @map("tx_hash")
  cryptoType             String        @map("crypto_type")
  cryptoAmount           Decimal       @map("crypto_amount")
  platformFeeAmount      Decimal       @map("platform_fee_amount")
  platformFeeCrypto      Decimal       @map("platform_fee_crypto")
  totalCryptoAmount      Decimal       @map("total_crypto_amount")
  senderCurrency         String        @map("sender_currency")
  senderCurrencyAmount   Decimal       @map("sender_currency_amount")
  receiverCurrency       String        @map("receiver_currency")
  receiverCurrencyAmount Decimal       @map("receiver_currency_amount")
  cryptoToSenderRate     Decimal       @map("crypto_to_sender_rate")
  senderToReceiverRate   Decimal       @map("sender_to_receiver_rate")
  platformFeePercent     Decimal       @map("platform_fee_percent")
  rateSource             String        @map("rate_source")
  rateSnapshotAt         DateTime      @map("rate_snapshot_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  expiresAt              DateTime      @map("expires_at")
  completedAt            DateTime?     @map("completed_at")
  failureReason          String?       @map("failure_reason")

  @@index([status, expiresAt])
  @@index([senderId])
  @@index([recipientUserId])
  @@index([externalRecipientId])
  @@map("payments")
}

model ExternalRecipient {
  id               String           @id @default(cuid()) @map("id")
  phoneNumber      String           @map("phone_number")
  countryCode      CountryCode      @map("country_code")
  localCurrency    String           @map("local_currency")
  method           WithdrawalMethod @map("method")
  encryptedDetails String           @map("encrypted_details")
  displayName      String           @map("display_name")
  createdAt        DateTime         @default(now()) @map("created_at")

  payments Payment[]

  @@index([phoneNumber])
  @@map("external_recipients")
}

model WebhookCursor {
  id            String   @id @default("singleton") @map("id")
  lastSignature String?  @map("last_signature")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("webhook_cursor")
}

model Wallet {
  id              String       @id @default(cuid()) @map("id")
  userId          String       @unique @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  currency        String       @default("INR") @map("currency")
  balance         Decimal      @default(0) @map("balance")
  reservedBalance Decimal      @default(0) @map("reserved_balance")
  status          WalletStatus @default(active) @map("status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  transactions  WalletTransaction[]
  debitEntries  LedgerEntry[]       @relation("DebitWallet")
  creditEntries LedgerEntry[]       @relation("CreditWallet")
  withdrawals   Withdrawal[]

  @@map("wallets")
}

model UserProfile {
  id            String      @id @default(cuid()) @map("id")
  userId        String      @unique @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  countryCode   CountryCode @map("country_code")
  localCurrency String      @map("local_currency")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  withdrawalAccounts WithdrawalAccount[]

  @@map("user_profiles")
}

model WithdrawalAccount {
  id               String           @id @default(cuid()) @map("id")
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id])
  profileId        String           @map("profile_id")
  profile          UserProfile      @relation(fields: [profileId], references: [id])
  method           WithdrawalMethod @map("method")
  countryCode      CountryCode      @map("country_code")
  isDefault        Boolean          @default(false) @map("is_default")
  isVerified       Boolean          @default(false) @map("is_verified")
  nickname         String?          @map("nickname")
  encryptedDetails String           @map("encrypted_details")
  displayName      String           @map("display_name")
  providerName     String           @default("mock") @map("provider_name")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  withdrawals Withdrawal[]

  @@index([userId])
  @@index([userId, method])
  @@map("withdrawal_accounts")
}

model Withdrawal {
  id                  String            @id @default(cuid()) @map("id")
  userId              String            @map("user_id")
  user                User              @relation(fields: [userId], references: [id])
  walletId            String            @map("wallet_id")
  wallet              Wallet            @relation(fields: [walletId], references: [id])
  accountId           String?           @map("account_id")
  account             WithdrawalAccount? @relation(fields: [accountId], references: [id])
  externalPaymentId   String?           @unique @map("external_payment_id")
  isExternalPayout    Boolean           @default(false) @map("is_external_payout")
  amount              Decimal           @map("amount")
  currency            String            @map("currency")
  feeAmount           Decimal           @default(0) @map("fee_amount")
  netAmount           Decimal           @map("net_amount")
  status              WithdrawalStatus  @default(pending) @map("status")
  method              WithdrawalMethod  @map("method")
  countryCode         CountryCode       @map("country_code")
  providerName        String            @default("mock") @map("provider_name")
  providerReference   String?           @map("provider_reference")
  providerResponse    Json?             @map("provider_response")
  isMocked            Boolean           @default(true) @map("is_mocked")
  mockCompletesAt     DateTime?         @map("mock_completes_at")
  failureReason       String?           @map("failure_reason")
  estimatedArrival    String?           @map("estimated_arrival")
  walletTransactionId String?           @unique @map("wallet_transaction_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  completedAt         DateTime?         @map("completed_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([walletId])
  @@index([status, mockCompletesAt])
  @@map("withdrawals")
}

model WalletTransaction {
  id                   String                  @id @default(cuid()) @map("id")
  walletId             String                  @map("wallet_id")
  wallet               Wallet                  @relation(fields: [walletId], references: [id])
  type                 WalletTransactionType   @map("type")
  amount               Decimal                 @map("amount")
  balanceBefore        Decimal                 @map("balance_before")
  balanceAfter         Decimal                 @map("balance_after")
  status               WalletTransactionStatus @default(completed) @map("status")
  reason               WalletEntryReason       @map("reason")
  title                String                  @map("title")
  description          String?                 @map("description")
  referenceType        String?                 @map("reference_type")
  referenceId          String?                 @map("reference_id")
  counterpartyId       String?                 @map("counterparty_id")
  counterpartyUsername String?                 @map("counterparty_username")
  counterpartyName     String?                 @map("counterparty_name")
  metadata             Json?                   @map("metadata")
  createdAt            DateTime                @default(now()) @map("created_at")
  ledgerEntry          LedgerEntry?

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model LedgerEntry {
  id                  String             @id @default(cuid()) @map("id")
  debitWalletId       String             @map("debit_wallet_id")
  creditWalletId      String             @map("credit_wallet_id")
  debitWallet         Wallet             @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet        Wallet             @relation("CreditWallet", fields: [creditWalletId], references: [id])
  amount              Decimal            @map("amount")
  currency            String             @default("INR") @map("currency")
  reason              WalletEntryReason  @map("reason")
  walletTransactionId String?            @unique @map("wallet_transaction_id")
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  referenceType       String?            @map("reference_type")
  referenceId         String?            @map("reference_id")
  note                String?            @map("note")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([debitWalletId])
  @@index([creditWalletId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

model SwapBatch {
  id            String     @id @default(cuid()) @map("id")
  currency      Currency   @map("currency")
  fromAmount    Decimal    @map("from_amount")
  toAmount      Decimal?   @map("to_amount")
  txHash        String?    @unique @map("tx_hash")
  status        SwapStatus @default(pending) @map("status")
  quoteResponse Json?      @map("quote_response")
  failureReason String?    @map("failure_reason")
  attempts      Int        @default(0) @map("attempts")
  createdAt     DateTime   @default(now()) @map("created_at")
  completedAt   DateTime?  @map("completed_at")

  @@index([status])
  @@index([currency, status])
  @@map("swap_batches")
}

model PushToken {
  id         String   @id @default(cuid()) @map("id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @map("token")
  platform   String   @default("unknown") @map("platform")
  deviceId   String?  @map("device_id")
  deviceName String?  @map("device_name")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, token], map: "push_tokens_user_id_token_key")
  @@index([userId])
  @@index([isActive])
  @@map("push_tokens")
}
