PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=
POSTGRES_DATABASE_URL=
REDIS_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Helius Dashboard -> API Keys
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Helius Dashboard -> Webhooks -> Secret
HELIUS_WEBHOOK_SECRET=

# Solana
# SOLANA_NETWORK must match the cluster your mints exist on (same as HELIUS RPC cluster).
# Mint addresses are NOT interchangeable across mainnet vs devnet — use the pair for your network.
SOLANA_NETWORK=mainnet
NEXIO_WALLET=
NEXIO_PRIVATE_KEY=

# SPL token mint addresses (see values below; decimals: USDT=6, USDC=6, LINK on Solana=9 per Chainlink CCIP)
#
# --- Mainnet-beta (production) ---
# USDT (Tether SPL, 6 decimals):
#   Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
#   https://explorer.solana.com/address/Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# USDC (Circle native USDC, 6 decimals):
#   EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   https://explorer.solana.com/address/EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# LINK (Chainlink on Solana, 9 decimals — CCIP token list “Solana” row):
#   LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L
#   https://docs.chain.link/ccip/directory/mainnet/token/LINK
#   https://explorer.solana.com/address/LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L
#
# --- Devnet (testing) ---
# USDT (“USDT (Saber Devnet)”, 6 decimals — devnet-only mint, not Tether mainnet USDT):
#   EJwZgeZrdC8TXTQbQBoL6bfuAnFUUy1PVCMB4DYPzVaS
#   https://explorer.solana.com/address/EJwZgeZrdC8TXTQbQBoL6bfuAnFUUy1PVCMB4DYPzVaS?cluster=devnet
# USDC (common devnet USDC used in Solana examples, 6 decimals):
#   4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#   https://explorer.solana.com/address/4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU?cluster=devnet
# LINK (Chainlink CCIP / devnet faucet mint; 9 decimals — verify balance with devnet explorer + faucets.chain.link):
#   LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L
#   https://explorer.solana.com/address/LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L?cluster=devnet
#   https://docs.chain.link/ccip/directory/testnet/chain/solana-devnet
#
# Example: mainnet (copy into vars below)
USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
LINK_MINT_ADDRESS=LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L
#
# Example: devnet — set SOLANA_NETWORK=devnet and use:
# USDT_MINT_ADDRESS=EJwZgeZrdC8TXTQbQBoL6bfuAnFUUy1PVCMB4DYPzVaS
# USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# LINK_MINT_ADDRESS=LinkhB3afbBKb2EQQu7s7umdZceV3wcvAUJhQAfQ23L

# Jupiter treasury swaps
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=

# Swap behavior
SWAP_ENABLED=false
# Leave empty to use Jupiter RTSE on /order. Set a number like 50 for fixed 0.5% slippage.
SWAP_SLIPPAGE_BPS=
SWAP_BATCH_INTERVAL_MINUTES=30
SWAP_MIN_AMOUNT_USD=5
SWAP_MAX_RETRIES=3

# Payment configuration
ACCEPT_OVERPAYMENT=true
PLATFORM_FEE_PERCENT=1.5
QUOTE_EXPIRES_IN_SECONDS=30
PAYMENT_EXPIRES_IN_MINUTES=5
FIAT_RATE_API_URL=https://api.frankfurter.app
FIAT_RATE_API_KEY=
PLATFORM_USER_ID=00000000-0000-0000-0000-000000000001

